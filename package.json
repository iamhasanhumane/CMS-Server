  "main": "server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --config nodemon.json --watch 'src/**/*.ts' --exec ts-node --files src/server.ts",
    "prestart": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint 'src/**/*.ts'",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:status": "sequelize-cli db:migrate:status",
    "build:migrate": "npm run migrate && npm run build",
    "start:migrate": "npm run migrate && npm run start",
    "vercel-build": "npm run build:migrate"
  },
